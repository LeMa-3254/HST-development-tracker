# TEMPLATE ONLY — this file is committed. Never put a real key here.
# Copy to .env (which is gitignored) and fill it in there.
ANTHROPIC_API_KEY=

# Optional: only needed if dedup.embedding_provider is set to "voyage" in targeting.yaml.
# By default dedup uses local (CPU) fastembed embeddings and needs no Voyage key.
VOYAGE_API_KEY=

# Optional local overrides for manual runs.
HST_CONFIG=targeting.yaml
HST_DB=data/tracker.db
